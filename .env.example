# Copy to .env in the project root (next to compose.yaml) and fill in real values.

# MongoDB connection string. In Docker Compose use the "mongo" service name.
MONGO_URI=mongodb://mongo:27017/meshai

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomUUID())"
JWT_SECRET=replace-with-a-long-random-string

# API key for Nebius AI Studio (embeddings + chat completions)
NEBIUS_API_KEY=replace-with-your-nebius-api-key

# Public address Caddy serves. Subdomain only, NO https:// prefix.
#   Production: SITE_ADDRESS=meshai.yourdomain.com
#   Local:      SITE_ADDRESS=:80   (serves http://localhost)
SITE_ADDRESS=:80
